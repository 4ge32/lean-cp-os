{
  "schema_version": 1,
  "assumptions": [
    {
      "id": "A-STATIC3",
      "statement": "Exactly low/mid/high with priorities 1/2/3; one core, maximum one active instance per task."
    },
    {
      "id": "A-ATOMIC",
      "statement": "Sequential atomic service transitions; no ISR, resource ownership, memory fault, or concurrent caller."
    },
    {
      "id": "A-VALID",
      "statement": "API preservation theorems assume Valid input; initial and finite reachability are proved."
    },
    {
      "id": "A-ABI",
      "statement": "Scalar ABI encodes canonical active masks 0..7 and serial callers; pointer ABI is not implemented."
    },
    {
      "id": "A-TRUST",
      "statement": "Lean kernel and compiler distribution, C compiler/linker/runtime, FFI glue, host OS and hardware are trusted; no compiled-code refinement proof."
    },
    {
      "id": "A-BASIC",
      "statement": "Finite static nonempty configuration of Basic Tasks, positive activation limits, one core. No internal resources, events or hook contexts. Resource ownership is an external call guard."
    },
    {
      "id": "A-CALLER",
      "statement": "Sequential atomic service steps. ISR nesting is an explicit environment boundary, not implemented physical interrupts. Interrupt-disabled calls are outside the supported call contract."
    },
    {
      "id": "A-TARGET",
      "statement": "Target scalar adapter: up to 4 tasks, priorities 0..15, sum of activation limits <=8, modeled ISR nesting <=15. Adapter correspondence and AArch64 stack switching are tested, not formally refined."
    }
  ],
